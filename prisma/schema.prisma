// Schema Prisma du MVP de scouting sportif gamifié

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoriePerformance {
  EXPLOSIVITE_PUISSANCE
  ENDURANCE
  COLLECTIF_TACTIQUE
  COMBAT
}

model Sport {
  id                   String               @id @default(cuid())
  nom                  String               @unique
  categoriePerformance CategoriePerformance
  createdAt            DateTime             @default(now())

  athletes   Athlete[]
  defis      Defi[]
  evenements Evenement[]
}

model Athlete {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  nom              String
  dateNaissance    DateTime
  ville            String
  sportPrincipalId String
  sportPrincipal   Sport    @relation(fields: [sportPrincipalId], references: [id])
  createdAt        DateTime @default(now())

  consentement    ConsentementParental?
  seances         Seance[]
  athleteBadges   AthleteBadge[]
  inscriptions    Inscription[]
  resultats       Resultat[]
  sessions        Session[]
}

model ConsentementParental {
  id              String    @id @default(cuid())
  athleteId       String    @unique
  athlete         Athlete   @relation(fields: [athleteId], references: [id])
  telephoneParent String
  code            String
  codeValide      Boolean   @default(false)
  dateValidation  DateTime?
  createdAt       DateTime  @default(now())
}

model Defi {
  id                   String                @id @default(cuid())
  sportId              String?
  sport                Sport?                @relation(fields: [sportId], references: [id])
  categoriePerformance CategoriePerformance?
  nom                  String                @unique
  description          String
  unite                String
  createdAt            DateTime              @default(now())

  seances Seance[]
}

model Seance {
  id            String   @id @default(cuid())
  athleteId     String
  athlete       Athlete  @relation(fields: [athleteId], references: [id])
  defiId        String
  defi          Defi     @relation(fields: [defiId], references: [id])
  valeurMesuree Float
  date          DateTime @default(now())
}

model Badge {
  id            String   @id @default(cuid())
  code          String   @unique
  nom           String
  description   String
  seuilSeances  Int
  createdAt     DateTime @default(now())

  athleteBadges AthleteBadge[]
}

model AthleteBadge {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  obtenuLe  DateTime @default(now())

  @@unique([athleteId, badgeId])
}

model Organisateur {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nom          String
  verifie      Boolean  @default(false)
  createdAt    DateTime @default(now())

  evenements Evenement[]
  sessions   Session[]
}

enum NiveauRequis {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
  TOUS_NIVEAUX
}

model Evenement {
  id                String       @id @default(cuid())
  organisateurId    String
  organisateur      Organisateur @relation(fields: [organisateurId], references: [id])
  nom               String
  sportId           String
  sport             Sport        @relation(fields: [sportId], references: [id])
  lieu              String
  date              DateTime
  placesMax         Int
  description       String
  niveauRequis      NiveauRequis
  clubRequis        Boolean      @default(false)
  ageMin            Int?
  ageMax            Int?
  nombreEquipesMax  Int?
  equipementFourni  String?
  fraisInscription  Int          @default(0)
  createdAt         DateTime     @default(now())

  inscriptions Inscription[]
  resultats    Resultat[]
}

enum StatutInscription {
  EN_ATTENTE
  CONFIRME
  REFUSE
}

model Inscription {
  id          String            @id @default(cuid())
  evenementId String
  evenement   Evenement         @relation(fields: [evenementId], references: [id])
  athleteId   String
  athlete     Athlete           @relation(fields: [athleteId], references: [id])
  statut      StatutInscription @default(EN_ATTENTE)
  createdAt   DateTime          @default(now())

  @@unique([evenementId, athleteId])
}

model Resultat {
  id          String    @id @default(cuid())
  evenementId String
  evenement   Evenement @relation(fields: [evenementId], references: [id])
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id])
  classement  Int
  score       Float
  createdAt   DateTime  @default(now())

  @@unique([evenementId, athleteId])
}

enum RoleSession {
  ATHLETE
  ORGANISATEUR
}

model Session {
  id             String        @id @default(cuid())
  token          String        @unique
  role           RoleSession
  athleteId      String?
  athlete        Athlete?      @relation(fields: [athleteId], references: [id])
  organisateurId String?
  organisateur   Organisateur? @relation(fields: [organisateurId], references: [id])
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
}

model Post {
  id        String      @id @default(cuid())
  auteurId  String
  auteurType RoleSession
  contenu   String
  imageUrl  String?
  createdAt DateTime    @default(now())

  likes        PostLike[]
  commentaires PostCommentaire[]
}

model PostLike {
  id         String      @id @default(cuid())
  postId     String
  post       Post        @relation(fields: [postId], references: [id])
  auteurId   String
  auteurType RoleSession
  createdAt  DateTime    @default(now())

  @@unique([postId, auteurId, auteurType])
}

model PostCommentaire {
  id         String      @id @default(cuid())
  postId     String
  post       Post        @relation(fields: [postId], references: [id])
  auteurId   String
  auteurType RoleSession
  contenu    String
  createdAt  DateTime    @default(now())
}
