// Schema Prisma du MVP de scouting sportif gamifié

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoriePerformance {
  EXPLOSIVITE_PUISSANCE
  ENDURANCE
  COLLECTIF_TACTIQUE
  COMBAT
  RENFORCEMENT_GENERAL
}

enum UniteMesure {
  REPETITIONS
  DUREE_SECONDES
  DISTANCE_METRES
  SERIES_X_REPETITIONS
}

enum SensAmelioration {
  PLUS_HAUT_MIEUX
  PLUS_BAS_MIEUX
}

enum PreferenceEffets {
  AUTO
  DEGRADE
  COMPLET
}

enum ThemeFond {
  CLAIR
  SOMBRE
  SPORT
}

enum RessentiSeance {
  DIFFICILE
  CORRECT
  FACILE
}

enum StatutProgramme {
  EN_COURS
  TERMINE
  ABANDONNE
}

enum StatutMatch {
  A_VENIR
  EN_COURS
  TERMINE
}

// EQUIPE : deux équipes, score classique (foot, basket, hand, volley, rugby).
// DUEL : deux athlètes (combat individuel) — score utilisé si la discipline
// compte des points (judo/taekwondo/boxe), sinon 0/0 avec statutTexte pour
// décrire la phase (lutte sénégalaise, dambe).
// COURSE : épreuve à plusieurs concurrents (athlétisme, natation, cyclisme) —
// pas de face-à-face, classement via MatchParticipant.
enum TypeMatch {
  EQUIPE
  DUEL
  COURSE
}

model Sport {
  id                   String               @id @default(cuid())
  nom                  String               @unique
  categoriePerformance CategoriePerformance
  createdAt            DateTime             @default(now())

  athletes   Athlete[]
  evenements Evenement[]
  articles   Article[]
  matchs     MatchDemo[]
}

model Athlete {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  nom              String
  dateNaissance    DateTime
  ville            String
  sportPrincipalId String
  sportPrincipal   Sport    @relation(fields: [sportPrincipalId], references: [id])
  createdAt        DateTime @default(now())

  suiviMensurationsActive Boolean          @default(false)
  preferenceEffetsVisuels PreferenceEffets @default(AUTO)
  themeFond               ThemeFond        @default(CLAIR)
  onboardingComplete      Boolean          @default(true)
  afficherFondSport       Boolean          @default(true)
  netteteFondSport        Int              @default(40)
  avatarUrl               String?
  bannerUrl               String?
  fondEcranUrl            String?

  consentement        ConsentementParental?
  seancesEntrainement SeanceEntrainement[]
  athleteBadges       AthleteBadge[]
  inscriptions        Inscription[]
  resultats           Resultat[]
  sessions            Session[]
  recordsPersonnels   RecordPersonnel[]
  objectifs           Objectif[]
  programmesSuivis    AthleteProgramme[]
  mensurations        Mensuration[]
}

model ConsentementParental {
  id              String    @id @default(cuid())
  athleteId       String    @unique
  athlete         Athlete   @relation(fields: [athleteId], references: [id])
  telephoneParent String
  code            String
  codeValide      Boolean   @default(false)
  dateValidation  DateTime?
  createdAt       DateTime  @default(now())
}

// Strictement privé : jamais exposé via une route acceptant un id
// d'athlète autre que celui de la session (voir /api/mensurations).
model Mensuration {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  date      DateTime @default(now())
  poidsKg   Float?
  tailleCm  Float?
  createdAt DateTime @default(now())
}

model Exercice {
  id                   String               @id @default(cuid())
  nom                  String               @unique
  categoriePerformance CategoriePerformance
  uniteMesure          UniteMesure
  sensAmelioration     SensAmelioration     @default(PLUS_HAUT_MIEUX)
  description          String
  beneficePerformance  String?
  createdAt            DateTime             @default(now())

  exercicesRealises  ExerciceRealise[]
  recordsPersonnels  RecordPersonnel[]
  objectifs          Objectif[]
  programmeExercices ProgrammeExercice[]
}

model SeanceEntrainement {
  id                String           @id @default(cuid())
  athleteId         String
  athlete           Athlete          @relation(fields: [athleteId], references: [id])
  date              DateTime         @default(now())
  noteOptionnelle   String?
  programmeSeanceId String?
  programmeSeance   ProgrammeSeance? @relation(fields: [programmeSeanceId], references: [id])
  createdAt         DateTime         @default(now())

  exercicesRealises ExerciceRealise[]
  postsPartages     Post[]
  retourSeance      RetourSeance?

  @@index([athleteId, date])
}

// Ressenti fermé (pas de conversation libre) associé à une séance, saisi via
// la mascotte scriptée à la fin de la séance.
model RetourSeance {
  id        String             @id @default(cuid())
  seanceId  String             @unique
  seance    SeanceEntrainement @relation(fields: [seanceId], references: [id])
  ressenti  RessentiSeance
  createdAt DateTime           @default(now())
}

model ExerciceRealise {
  id         String             @id @default(cuid())
  seanceId   String
  seance     SeanceEntrainement @relation(fields: [seanceId], references: [id])
  exerciceId String
  exercice   Exercice           @relation(fields: [exerciceId], references: [id])
  createdAt  DateTime           @default(now())

  series Serie[]
}

model Serie {
  id                 String          @id @default(cuid())
  exerciceRealiseId  String
  exerciceRealise    ExerciceRealise @relation(fields: [exerciceRealiseId], references: [id])
  numeroSerie        Int
  repetitions        Int?
  poidsKg            Float?
  dureeSecondes      Float?
  distanceMetres     Float?
  tempsReposSecondes Int?
  createdAt          DateTime        @default(now())
}

model RecordPersonnel {
  id              String   @id @default(cuid())
  athleteId       String
  athlete         Athlete  @relation(fields: [athleteId], references: [id])
  exerciceId      String
  exercice        Exercice @relation(fields: [exerciceId], references: [id])
  valeur          Float
  dateRealisation DateTime
  createdAt       DateTime @default(now())

  @@unique([athleteId, exerciceId])
}

model Objectif {
  id          String    @id @default(cuid())
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id])
  exerciceId  String
  exercice    Exercice  @relation(fields: [exerciceId], references: [id])
  valeurCible Float
  dateLimite  DateTime?
  atteint     Boolean   @default(false)
  dateAtteint DateTime?
  createdAt   DateTime  @default(now())
}

model Programme {
  id                   String                @id @default(cuid())
  nom                  String
  description          String
  dureeSemaines        Int
  categoriePerformance CategoriePerformance?
  createdAt            DateTime              @default(now())

  seances          ProgrammeSeance[]
  athletesSuiveurs AthleteProgramme[]
}

model ProgrammeSeance {
  id            String    @id @default(cuid())
  programmeId   String
  programme     Programme @relation(fields: [programmeId], references: [id])
  numeroSemaine Int
  numeroJour    Int
  nomSeance     String
  createdAt     DateTime  @default(now())

  exercicesPrevus  ProgrammeExercice[]
  seancesRealisees SeanceEntrainement[]
}

model ProgrammeExercice {
  id                   String          @id @default(cuid())
  programmeSeanceId    String
  programmeSeance      ProgrammeSeance @relation(fields: [programmeSeanceId], references: [id])
  exerciceId           String
  exercice             Exercice        @relation(fields: [exerciceId], references: [id])
  seriesPrevues        Int?
  repetitionsPrevues   Int?
  dureePrevueSecondes  Float?
  distancePrevueMetres Float?
  poidsPrevuKg         Float?
  createdAt            DateTime        @default(now())
}

model AthleteProgramme {
  id          String          @id @default(cuid())
  athleteId   String
  athlete     Athlete         @relation(fields: [athleteId], references: [id])
  programmeId String
  programme   Programme       @relation(fields: [programmeId], references: [id])
  dateDebut   DateTime        @default(now())
  statut      StatutProgramme @default(EN_COURS)
  createdAt   DateTime        @default(now())
}

model Badge {
  id           String   @id @default(cuid())
  code         String   @unique
  nom          String
  description  String
  seuilSeances Int
  createdAt    DateTime @default(now())

  athleteBadges AthleteBadge[]
}

model AthleteBadge {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  obtenuLe  DateTime @default(now())

  @@unique([athleteId, badgeId])
}

model Organisateur {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nom          String
  verifie      Boolean  @default(false)
  createdAt    DateTime @default(now())

  evenements Evenement[]
  sessions   Session[]
}

enum NiveauRequis {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
  TOUS_NIVEAUX
}

model Evenement {
  id               String       @id @default(cuid())
  organisateurId   String
  organisateur     Organisateur @relation(fields: [organisateurId], references: [id])
  nom              String
  sportId          String
  sport            Sport        @relation(fields: [sportId], references: [id])
  lieu             String
  date             DateTime
  placesMax        Int
  description      String
  niveauRequis     NiveauRequis
  clubRequis       Boolean      @default(false)
  ageMin           Int?
  ageMax           Int?
  nombreEquipesMax Int?
  equipementFourni String?
  fraisInscription Int          @default(0)
  createdAt        DateTime     @default(now())

  inscriptions Inscription[]
  resultats    Resultat[]
  images       EvenementImage[]

  @@index([date])
}

model EvenementImage {
  id          String    @id @default(cuid())
  evenementId String
  evenement   Evenement @relation(fields: [evenementId], references: [id])
  url         String
  ordre       Int
  createdAt   DateTime  @default(now())
}

enum StatutInscription {
  EN_ATTENTE
  CONFIRME
  REFUSE
}

model Inscription {
  id          String            @id @default(cuid())
  evenementId String
  evenement   Evenement         @relation(fields: [evenementId], references: [id])
  athleteId   String
  athlete     Athlete           @relation(fields: [athleteId], references: [id])
  statut      StatutInscription @default(EN_ATTENTE)
  createdAt   DateTime          @default(now())

  @@unique([evenementId, athleteId])
}

model Resultat {
  id          String    @id @default(cuid())
  evenementId String
  evenement   Evenement @relation(fields: [evenementId], references: [id])
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id])
  classement  Int
  score       Float
  createdAt   DateTime  @default(now())

  @@unique([evenementId, athleteId])
}

enum RoleSession {
  ATHLETE
  ORGANISATEUR
}

model Session {
  id             String        @id @default(cuid())
  token          String        @unique
  role           RoleSession
  athleteId      String?
  athlete        Athlete?      @relation(fields: [athleteId], references: [id])
  organisateurId String?
  organisateur   Organisateur? @relation(fields: [organisateurId], references: [id])
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
}

model Post {
  id                   String              @id @default(cuid())
  auteurId             String
  auteurType           RoleSession
  contenu              String
  seanceEntrainementId String?
  seanceEntrainement   SeanceEntrainement? @relation(fields: [seanceEntrainementId], references: [id])
  createdAt            DateTime            @default(now())

  likes        PostLike[]
  commentaires PostCommentaire[]
  images       PostImage[]
  vues         PostVue[]
  sauvegardes  PostSauvegarde[]

  @@index([createdAt])
  @@index([auteurId, auteurType])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  url       String
  ordre     Int
  createdAt DateTime @default(now())
}

model PostLike {
  id         String      @id @default(cuid())
  postId     String
  post       Post        @relation(fields: [postId], references: [id])
  auteurId   String
  auteurType RoleSession
  createdAt  DateTime    @default(now())

  @@unique([postId, auteurId, auteurType])
}

// Un post enregistré par un spectateur (bouton "Sauvegarder"), simple
// marque-page personnel — n'affecte ni les compteurs ni la visibilité du
// post pour les autres.
model PostSauvegarde {
  id         String      @id @default(cuid())
  postId     String
  post       Post        @relation(fields: [postId], references: [id])
  auteurId   String
  auteurType RoleSession
  createdAt  DateTime    @default(now())

  @@unique([postId, auteurId, auteurType])
}

model PostCommentaire {
  id         String      @id @default(cuid())
  postId     String
  post       Post        @relation(fields: [postId], references: [id])
  auteurId   String
  auteurType RoleSession
  contenu    String
  createdAt  DateTime    @default(now())
}

// Une vue est enregistrée à l'ouverture de la vue détaillée d'un post
// uniquement (pas au défilement dans le fil) ; l'unicité empêche un même
// compte de faire grimper le compteur en rouvrant le post plusieurs fois.
model PostVue {
  id             String      @id @default(cuid())
  postId         String
  post           Post        @relation(fields: [postId], references: [id])
  spectateurId   String
  spectateurType RoleSession
  vuLe           DateTime    @default(now())

  @@unique([postId, spectateurId, spectateurType])
}

// Le blocage de l'auto-abonnement est vérifié en application (route API),
// pas par une contrainte SQL.
model Abonnement {
  id          String      @id @default(cuid())
  suiveurId   String
  suiveurType RoleSession
  suiviId     String
  suiviType   RoleSession
  createdAt   DateTime    @default(now())

  @@unique([suiveurId, suiveurType, suiviId, suiviType])
  @@index([suiviId, suiviType])
}

// Contenu éditorial (rédigé par la plateforme, pas par les utilisateurs) —
// pas de champ auteur polymorphe contrairement à Post, mais rattaché à un
// sport pour permettre le filtrage par sport dans le menu Actualités.
model Article {
  id        String   @id @default(cuid())
  titre     String
  chapo     String
  contenu   String
  source    String
  imageUrl  String
  sportId   String
  sport     Sport    @relation(fields: [sportId], references: [id])
  publieLe  DateTime @default(now())
  createdAt DateTime @default(now())

  likes        ArticleLike[]
  commentaires ArticleCommentaire[]
  vues         ArticleVue[]

  @@index([publieLe])
  @@index([sportId])
}

model ArticleLike {
  id         String      @id @default(cuid())
  articleId  String
  article    Article     @relation(fields: [articleId], references: [id])
  auteurId   String
  auteurType RoleSession
  createdAt  DateTime    @default(now())

  @@unique([articleId, auteurId, auteurType])
}

model ArticleCommentaire {
  id         String      @id @default(cuid())
  articleId  String
  article    Article     @relation(fields: [articleId], references: [id])
  auteurId   String
  auteurType RoleSession
  contenu    String
  createdAt  DateTime    @default(now())

  @@index([articleId, createdAt])
}

// Une vue par compte et par article, comme PostVue — enregistrée à
// l'ouverture de la vue détaillée uniquement.
model ArticleVue {
  id             String      @id @default(cuid())
  articleId      String
  article        Article     @relation(fields: [articleId], references: [id])
  spectateurId   String
  spectateurType RoleSession
  vuLe           DateTime    @default(now())

  @@unique([articleId, spectateurId, spectateurType])
}

// Score/progression de démonstration (pas de vrai flux live) : un instantané
// figé par le seed, affiché tel quel sur la carte "en direct" du menu
// Actualités. equipeA/equipeB en toutes lettres (pas de relation vers un
// club ni un athlète, aucun modèle "équipe" n'existe dans l'app).
//
// Le sens de equipeA/equipeB/scoreA/scoreB dépend de `type` :
// - EQUIPE : deux équipes et leur score.
// - DUEL   : deux athlètes ; score si la discipline en a un, sinon 0/0 et
//            `statutTexte` décrit la phase du combat.
// - COURSE : equipeA = nom de l'épreuve, equipeB/scoreA/scoreB inutilisés
//            (chaîne vide / 0), le classement vit dans `participants`.
model MatchDemo {
  id             String      @id @default(cuid())
  sportId        String
  sport          Sport       @relation(fields: [sportId], references: [id])
  type           TypeMatch   @default(EQUIPE)
  equipeA        String
  equipeB        String
  scoreA         Int
  scoreB         Int
  statutTexte    String?
  statut         StatutMatch
  minuteAffichee String?
  lieu           String
  dateMatch      DateTime
  imageUrl       String
  createdAt      DateTime    @default(now())

  participants MatchParticipant[]

  @@index([sportId])
  @@index([statut])
}

// Classement d'une épreuve de type COURSE (athlétisme, natation, cyclisme) :
// plusieurs concurrents, pas un face-à-face — resultat en texte libre
// (temps, écart, distance) car le format diffère trop d'une discipline à
// l'autre pour une colonne numérique unique.
model MatchParticipant {
  id        String    @id @default(cuid())
  matchId   String
  match     MatchDemo @relation(fields: [matchId], references: [id])
  position  Int
  nom       String
  resultat  String
  createdAt DateTime  @default(now())

  @@index([matchId])
}
