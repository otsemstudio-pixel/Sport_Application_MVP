// Schema Prisma du MVP de scouting sportif gamifié

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoriePerformance {
  EXPLOSIVITE_PUISSANCE
  ENDURANCE
  COLLECTIF_TACTIQUE
  COMBAT
  RENFORCEMENT_GENERAL
}

enum UniteMesure {
  REPETITIONS
  DUREE_SECONDES
  DISTANCE_METRES
  SERIES_X_REPETITIONS
}

enum SensAmelioration {
  PLUS_HAUT_MIEUX
  PLUS_BAS_MIEUX
}

enum PreferenceEffets {
  AUTO
  DEGRADE
  COMPLET
}

enum ThemeFond {
  CLAIR
  SOMBRE
  SPORT
}

enum RessentiSeance {
  DIFFICILE
  CORRECT
  FACILE
}

enum StatutProgramme {
  EN_COURS
  TERMINE
  ABANDONNE
}

enum PreferenceNotifications {
  DESACTIVE
  QUOTIDIEN
  QUELQUES_FOIS_SEMAINE
}

enum TypeEvenementXp {
  SEANCE_COMPLETEE
  DEFI_DUJOUR
  REPOS_PLANIFIE_RESPECTE
  OBJECTIF_ATTEINT
  RECORD_PERSONNEL
  BADGE_DEBLOQUE
  INSCRIPTION_TOURNOI
  RESULTAT_TOURNOI
}

enum MouvementLigue {
  PROMOTION
  RELEGATION
  STABLE
}

model Sport {
  id                   String               @id @default(cuid())
  nom                  String               @unique
  categoriePerformance CategoriePerformance
  createdAt            DateTime             @default(now())

  // Dernière fois que ce sport a servi de mot-clé pour interroger
  // NewsData.io (voir lib/newsdata.ts) — permet une rotation qui priorise
  // les sports les moins récemment interrogés plutôt que de tout requêter à
  // chaque passage, pour ne pas épuiser le quota gratuit.
  derniereRechercheActualite DateTime?

  athletes     Athlete[]
  evenements   Evenement[]
  actualites   Actualite[]
  ligueGroupes LigueGroupe[]
}

model Athlete {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  nom              String
  // Identifiant stable pour les mentions (@nomUtilisateur), distinct du nom
  // d'affichage qui peut changer. Unicité appliquée au niveau applicatif à
  // travers Athlete ET Organisateur ensemble (une contrainte @unique Prisma
  // ne porte que sur une seule table) — même principe que le blocage de
  // l'auto-abonnement, déjà vérifié en application plutôt qu'en contrainte
  // SQL. Toujours en minuscules pour une résolution des mentions sans
  // ambiguïté de casse.
  nomUtilisateur   String   @unique
  dateNaissance    DateTime
  ville            String
  sportPrincipalId String
  sportPrincipal   Sport    @relation(fields: [sportPrincipalId], references: [id])
  createdAt        DateTime @default(now())

  suiviMensurationsActive Boolean          @default(false)
  preferenceEffetsVisuels PreferenceEffets @default(AUTO)
  themeFond               ThemeFond        @default(CLAIR)
  onboardingComplete      Boolean          @default(true)
  afficherFondSport       Boolean          @default(true)
  netteteFondSport        Int              @default(40)
  avatarUrl               String?
  bannerUrl               String?
  fondEcranUrl            String?

  // Système d'engagement quotidien : total d'XP dénormalisé pour un
  // affichage rapide (les gains détaillés vivent dans EvenementXp), jamais
  // activé par défaut sans consentement explicite de l'athlète, et clé de
  // semaine ISO (ex. "2026-W32") du dernier résumé hebdomadaire déjà vu pour
  // ne l'afficher qu'une fois par semaine.
  xpTotal                  Int                     @default(0)
  preferenceNotifications  PreferenceNotifications @default(DESACTIVE)
  derniereSemaineResumeVue String?

  consentement        ConsentementParental?
  seancesEntrainement SeanceEntrainement[]
  athleteBadges       AthleteBadge[]
  inscriptions        Inscription[]
  resultats           Resultat[]
  sessions            Session[]
  recordsPersonnels   RecordPersonnel[]
  objectifs           Objectif[]
  programmesSuivis    AthleteProgramme[]
  mensurations        Mensuration[]

  preferenceAssiduite     PreferenceAssiduite?
  jokersAssiduite         JokerAssiduite[]
  evenementsXp            EvenementXp[]
  ligueMembres            LigueMembre[]
  abonnementsNotification AbonnementNotification[]
}

model ConsentementParental {
  id              String    @id @default(cuid())
  athleteId       String    @unique
  athlete         Athlete   @relation(fields: [athleteId], references: [id])
  telephoneParent String
  code            String
  codeValide      Boolean   @default(false)
  dateValidation  DateTime?
  createdAt       DateTime  @default(now())
}

// Strictement privé : jamais exposé via une route acceptant un id
// d'athlète autre que celui de la session (voir /api/mensurations).
model Mensuration {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  date      DateTime @default(now())
  poidsKg   Float?
  tailleCm  Float?
  createdAt DateTime @default(now())
}

model Exercice {
  id                   String               @id @default(cuid())
  nom                  String               @unique
  categoriePerformance CategoriePerformance
  uniteMesure          UniteMesure
  sensAmelioration     SensAmelioration     @default(PLUS_HAUT_MIEUX)
  description          String
  beneficePerformance  String?
  createdAt            DateTime             @default(now())

  exercicesRealises  ExerciceRealise[]
  recordsPersonnels  RecordPersonnel[]
  objectifs          Objectif[]
  programmeExercices ProgrammeExercice[]
}

model SeanceEntrainement {
  id                String           @id @default(cuid())
  athleteId         String
  athlete           Athlete          @relation(fields: [athleteId], references: [id])
  date              DateTime         @default(now())
  noteOptionnelle   String?
  programmeSeanceId String?
  programmeSeance   ProgrammeSeance? @relation(fields: [programmeSeanceId], references: [id])
  createdAt         DateTime         @default(now())

  exercicesRealises ExerciceRealise[]
  postsPartages     Post[]
  retourSeance      RetourSeance?

  @@index([athleteId, date])
}

// Ressenti fermé (pas de conversation libre) associé à une séance, saisi via
// la mascotte scriptée à la fin de la séance.
model RetourSeance {
  id        String             @id @default(cuid())
  seanceId  String             @unique
  seance    SeanceEntrainement @relation(fields: [seanceId], references: [id])
  ressenti  RessentiSeance
  createdAt DateTime           @default(now())
}

model ExerciceRealise {
  id         String             @id @default(cuid())
  seanceId   String
  seance     SeanceEntrainement @relation(fields: [seanceId], references: [id])
  exerciceId String
  exercice   Exercice           @relation(fields: [exerciceId], references: [id])
  createdAt  DateTime           @default(now())

  series Serie[]
}

model Serie {
  id                 String          @id @default(cuid())
  exerciceRealiseId  String
  exerciceRealise    ExerciceRealise @relation(fields: [exerciceRealiseId], references: [id])
  numeroSerie        Int
  repetitions        Int?
  poidsKg            Float?
  dureeSecondes      Float?
  distanceMetres     Float?
  tempsReposSecondes Int?
  createdAt          DateTime        @default(now())
}

model RecordPersonnel {
  id              String   @id @default(cuid())
  athleteId       String
  athlete         Athlete  @relation(fields: [athleteId], references: [id])
  exerciceId      String
  exercice        Exercice @relation(fields: [exerciceId], references: [id])
  valeur          Float
  dateRealisation DateTime
  createdAt       DateTime @default(now())

  @@unique([athleteId, exerciceId])
}

model Objectif {
  id          String    @id @default(cuid())
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id])
  exerciceId  String
  exercice    Exercice  @relation(fields: [exerciceId], references: [id])
  valeurCible Float
  dateLimite  DateTime?
  atteint     Boolean   @default(false)
  dateAtteint DateTime?
  createdAt   DateTime  @default(now())
}

model Programme {
  id                   String                @id @default(cuid())
  nom                  String
  description          String
  dureeSemaines        Int
  categoriePerformance CategoriePerformance?
  createdAt            DateTime              @default(now())

  seances          ProgrammeSeance[]
  athletesSuiveurs AthleteProgramme[]
}

model ProgrammeSeance {
  id            String    @id @default(cuid())
  programmeId   String
  programme     Programme @relation(fields: [programmeId], references: [id])
  numeroSemaine Int
  numeroJour    Int
  nomSeance     String
  createdAt     DateTime  @default(now())

  exercicesPrevus  ProgrammeExercice[]
  seancesRealisees SeanceEntrainement[]
}

model ProgrammeExercice {
  id                   String          @id @default(cuid())
  programmeSeanceId    String
  programmeSeance      ProgrammeSeance @relation(fields: [programmeSeanceId], references: [id])
  exerciceId           String
  exercice             Exercice        @relation(fields: [exerciceId], references: [id])
  seriesPrevues        Int?
  repetitionsPrevues   Int?
  dureePrevueSecondes  Float?
  distancePrevueMetres Float?
  poidsPrevuKg         Float?
  createdAt            DateTime        @default(now())
}

model AthleteProgramme {
  id          String          @id @default(cuid())
  athleteId   String
  athlete     Athlete         @relation(fields: [athleteId], references: [id])
  programmeId String
  programme   Programme       @relation(fields: [programmeId], references: [id])
  dateDebut   DateTime        @default(now())
  statut      StatutProgramme @default(EN_COURS)
  createdAt   DateTime        @default(now())
}

model Badge {
  id           String   @id @default(cuid())
  code         String   @unique
  nom          String
  description  String
  seuilSeances Int
  createdAt    DateTime @default(now())

  athleteBadges AthleteBadge[]
}

model AthleteBadge {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  obtenuLe  DateTime @default(now())

  @@unique([athleteId, badgeId])
}

model Organisateur {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  nom            String
  // Voir le commentaire équivalent sur Athlete.nomUtilisateur.
  nomUtilisateur String   @unique
  verifie        Boolean  @default(false)
  createdAt      DateTime @default(now())

  evenements Evenement[]
  sessions   Session[]
}

enum NiveauRequis {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
  TOUS_NIVEAUX
}

model Evenement {
  id               String       @id @default(cuid())
  organisateurId   String
  organisateur     Organisateur @relation(fields: [organisateurId], references: [id])
  nom              String
  sportId          String
  sport            Sport        @relation(fields: [sportId], references: [id])
  lieu             String
  date             DateTime
  placesMax        Int
  description      String
  niveauRequis     NiveauRequis
  clubRequis       Boolean      @default(false)
  ageMin           Int?
  ageMax           Int?
  nombreEquipesMax Int?
  equipementFourni String?
  fraisInscription Int          @default(0)
  createdAt        DateTime     @default(now())

  inscriptions Inscription[]
  resultats    Resultat[]
  images       EvenementImage[]

  @@index([date])
}

model EvenementImage {
  id          String    @id @default(cuid())
  evenementId String
  evenement   Evenement @relation(fields: [evenementId], references: [id])
  url         String
  ordre       Int
  createdAt   DateTime  @default(now())
}

enum StatutInscription {
  EN_ATTENTE
  CONFIRME
  REFUSE
}

model Inscription {
  id          String            @id @default(cuid())
  evenementId String
  evenement   Evenement         @relation(fields: [evenementId], references: [id])
  athleteId   String
  athlete     Athlete           @relation(fields: [athleteId], references: [id])
  statut      StatutInscription @default(EN_ATTENTE)
  createdAt   DateTime          @default(now())

  @@unique([evenementId, athleteId])
}

model Resultat {
  id          String    @id @default(cuid())
  evenementId String
  evenement   Evenement @relation(fields: [evenementId], references: [id])
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id])
  classement  Int
  score       Float
  createdAt   DateTime  @default(now())

  @@unique([evenementId, athleteId])
}

enum RoleSession {
  ATHLETE
  ORGANISATEUR
}

model Session {
  id             String        @id @default(cuid())
  token          String        @unique
  role           RoleSession
  athleteId      String?
  athlete        Athlete?      @relation(fields: [athleteId], references: [id])
  organisateurId String?
  organisateur   Organisateur? @relation(fields: [organisateurId], references: [id])
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
}

model Post {
  id                   String              @id @default(cuid())
  auteurId             String
  auteurType           RoleSession
  contenu              String
  seanceEntrainementId String?
  seanceEntrainement   SeanceEntrainement? @relation(fields: [seanceEntrainementId], references: [id])
  createdAt            DateTime            @default(now())

  likes        PostLike[]
  commentaires PostCommentaire[]
  images       PostImage[]
  vues         PostVue[]
  sauvegardes  PostSauvegarde[]
  hashtags     PostHashtag[]
  mentions     Mention[]

  @@index([createdAt])
  @@index([auteurId, auteurType])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  url       String
  ordre     Int
  createdAt DateTime @default(now())
}

model PostLike {
  id         String      @id @default(cuid())
  postId     String
  post       Post        @relation(fields: [postId], references: [id])
  auteurId   String
  auteurType RoleSession
  createdAt  DateTime    @default(now())

  @@unique([postId, auteurId, auteurType])
}

// Un post enregistré par un spectateur (bouton "Sauvegarder"), simple
// marque-page personnel — n'affecte ni les compteurs ni la visibilité du
// post pour les autres.
model PostSauvegarde {
  id         String      @id @default(cuid())
  postId     String
  post       Post        @relation(fields: [postId], references: [id])
  auteurId   String
  auteurType RoleSession
  createdAt  DateTime    @default(now())

  @@unique([postId, auteurId, auteurType])
}

model PostCommentaire {
  id         String      @id @default(cuid())
  postId     String
  post       Post        @relation(fields: [postId], references: [id])
  auteurId   String
  auteurType RoleSession
  contenu    String
  createdAt  DateTime    @default(now())

  mentions Mention[]
}

// Un hashtag n'existe qu'une fois (texte normalisé, sans le #), réutilisé
// par tous les posts qui le mentionnent — pas de lien vers les commentaires
// (le doc ne prévoit ce croisement que pour les posts, l'écran /hashtag/[tag]
// n'a de sens que pour un contenu qui a sa propre page de destination).
model Hashtag {
  id        String        @id @default(cuid())
  tag       String        @unique
  createdAt DateTime      @default(now())
  posts     PostHashtag[]
}

model PostHashtag {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  hashtagId String
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, hashtagId])
  @@index([hashtagId])
}

// Une mention appartient soit à un post soit à un commentaire, jamais les
// deux (contrainte CHECK ajoutée en SQL, voir la migration). Contrairement
// à Hashtag, sans réutilisation possible : une ligne par occurrence, comme
// PostVue/PostLike (mêmes champs auteur/spectateur polymorphes déjà utilisés
// partout ailleurs dans l'app).
model Mention {
  id            String           @id @default(cuid())
  postId        String?
  post          Post?            @relation(fields: [postId], references: [id])
  commentaireId String?
  commentaire   PostCommentaire? @relation(fields: [commentaireId], references: [id])
  mentionneId   String
  mentionneType RoleSession
  createdAt     DateTime         @default(now())

  @@index([mentionneId, mentionneType])
  @@index([postId])
  @@index([commentaireId])
}

// Une vue est enregistrée à l'ouverture de la vue détaillée d'un post
// uniquement (pas au défilement dans le fil) ; l'unicité empêche un même
// compte de faire grimper le compteur en rouvrant le post plusieurs fois.
model PostVue {
  id             String      @id @default(cuid())
  postId         String
  post           Post        @relation(fields: [postId], references: [id])
  spectateurId   String
  spectateurType RoleSession
  vuLe           DateTime    @default(now())

  @@unique([postId, spectateurId, spectateurType])
}

// Le blocage de l'auto-abonnement est vérifié en application (route API),
// pas par une contrainte SQL.
model Abonnement {
  id          String      @id @default(cuid())
  suiveurId   String
  suiveurType RoleSession
  suiviId     String
  suiviType   RoleSession
  createdAt   DateTime    @default(now())

  @@unique([suiveurId, suiveurType, suiviId, suiviType])
  @@index([suiviId, suiviType])
}

enum SourceActualite {
  NEWSDATA
  RSS
}

enum CategorieActualite {
  RESULTAT_TOURNOI
  BOURSE_OPPORTUNITE
  SELECTION_NATIONALE
  GENERAL
}

// Actualité/opportunité externe (résultats de tournois, bourses sportives,
// sélections nationales), récupérée périodiquement par un job cron
// (app/api/cron/actualites) depuis NewsData.io et des flux RSS — jamais en
// direct depuis une requête utilisateur. Le contenu intégral n'est jamais
// republié : seuls titre/résumé sont stockés, `urlSource` renvoie vers
// l'article original. `urlSource` est unique pour dédupliquer entre passages
// successifs du job et entre les deux sources.
model Actualite {
  id         String             @id @default(cuid())
  titre      String
  resume     String
  urlSource  String             @unique
  imageUrl   String?
  sourceNom  String
  sourceType SourceActualite
  categorie  CategorieActualite
  // Renseigné seulement quand l'entrée provient d'une requête NewsData.io
  // liée à un sport précis (pas pour RSS, ni pour la requête complémentaire
  // structurée category+country qui n'est pas rattachée à un sport unique).
  sportId    String?
  sport      Sport?             @relation(fields: [sportId], references: [id])
  publieLe   DateTime
  recupereLe DateTime           @default(now())

  @@index([publieLe])
  @@index([categorie])
  @@index([sportId])
}

// Système d'engagement quotidien inspiré de Duolingo, adapté au risque
// physique du sport : la série (streak) n'est PAS un compteur stocké à
// incrémenter/casser par un job — elle est recalculée à la volée depuis
// l'historique réel (voir lib/assiduite.ts), donc jamais désynchronisée et
// sans dépendance à un cron pour "réinitialiser" quoi que ce soit. Nommé
// "Assiduite" pour éviter toute collision avec le modèle Serie existant
// (un set/une répétition d'entraînement, sans rapport).
model PreferenceAssiduite {
  id        String  @id @default(cuid())
  athleteId String  @unique
  athlete   Athlete @relation(fields: [athleteId], references: [id])

  // Jours de la semaine (0=dimanche..6=samedi) où un repos planifié compte
  // comme un jour normal de la série. Maximum 2, vérifié en application.
  joursReposPlanifies Int[]

  updatedAt DateTime @updatedAt
}

// Un jour non planifié manqué, couvert ponctuellement sans casser la série
// — présenté comme un outil de gestion de la fatigue, pas un simple
// bouclier anti-punition. Plafond de 2/mois vérifié en application (comptage
// des lignes du mois en cours), même principe que l'unicité croisée du nom
// d'utilisateur déjà en place ailleurs dans ce schéma.
model JokerAssiduite {
  id           String   @id @default(cuid())
  athleteId    String
  athlete      Athlete  @relation(fields: [athleteId], references: [id])
  dateCouverte DateTime
  createdAt    DateTime @default(now())

  @@unique([athleteId, dateCouverte])
}

// Journal des gains d'XP (voir lib/xp.ts) — nécessaire en plus du total
// dénormalisé sur Athlete.xpTotal pour pouvoir sommer l'XP sur une fenêtre
// glissante (semaine de ligue en cours, résumé hebdomadaire).
model EvenementXp {
  id        String          @id @default(cuid())
  athleteId String
  athlete   Athlete         @relation(fields: [athleteId], references: [id])
  type      TypeEvenementXp
  montant   Int
  createdAt DateTime        @default(now())

  @@index([athleteId, createdAt])
}

// Cohorte hebdomadaire d'une ligue (regroupement ville+sport, par niveau de
// XP de la semaine précédente). `niveau` permet plusieurs divisions
// parallèles pour un même ville+sport quand la base d'utilisateurs grandit
// au point de dépasser 20-30 personnes par groupe — à l'échelle actuelle,
// reste à 1 pour toutes les combinaisons.
model LigueGroupe {
  id        String   @id @default(cuid())
  semaine   String
  ville     String
  sportId   String
  sport     Sport    @relation(fields: [sportId], references: [id])
  niveau    Int      @default(1)
  createdAt DateTime @default(now())

  membres LigueMembre[]

  @@unique([semaine, ville, sportId, niveau])
}

model LigueMembre {
  id        String          @id @default(cuid())
  groupeId  String
  groupe    LigueGroupe     @relation(fields: [groupeId], references: [id])
  athleteId String
  athlete   Athlete         @relation(fields: [athleteId], references: [id])
  // Incrémenté en direct à chaque gain d'XP de la semaine (voir lib/xp.ts),
  // pas recalculé après coup par agrégation à chaque chargement de page.
  xpSemaine Int             @default(0)
  // Renseignés uniquement à la clôture de la semaine (lib/ligues.ts) — null
  // tant que la semaine est en cours.
  rangFinal Int?
  mouvement MouvementLigue?

  @@unique([groupeId, athleteId])
  @@index([athleteId])
}

// Souscription Web Push du navigateur d'un athlète (Web Push API +
// service worker, voir public/sw.js) — jamais créée sans action explicite de
// l'athlète dans ses réglages de notifications.
model AbonnementNotification {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
